{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "standamailtrack",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Daily digest check at 13:00 UTC (9am New York in summer, 8am in winter).
  "triggers": { "crons": ["0 13 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "standamailtrack",
      "database_id": "9a7cef85-79e1-408a-b164-140454733a2c",
      "migrations_dir": "migrations"
    }
  ]
  // API_TOKEN is a secret: `npx wrangler secret put API_TOKEN` (locally: .dev.vars)
}
